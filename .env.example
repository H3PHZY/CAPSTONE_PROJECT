# Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Same as the Supabase URL. Used on the server to check image URLs.
PROJECT_URL=https://YOUR_PROJECT_REF.supabase.co

# Server-only (never expose to the browser)
# Needed by the Paystack API routes (app/api/paystack/*)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Paystack, test mode (Dashboard > Settings > API Keys)
NEXT_PUBLIC_PAYSTACK_TEST_KEY=pk_test_your_public_key
# Server-only. Used to verify payments.
PAYSTACK_SECRET_KEY=sk_test_your_secret_key

# Hugging Face (https://huggingface.co/settings/tokens)
# Needs the "Inference Providers" permission.
HF_TOKEN=hf_your_access_token
# Specialist model, tried after the general ViT model
HF_MODEL_ID=yangy50/garbage-classification
# Optional: change the general ViT model that is tried first
# HF_VIT_MODEL=google/vit-base-patch16-224
# Optional (paid or dedicated): Deploy > Inference Endpoints > paste URL.
# If set, the app uses only this endpoint.
# HF_ENDPOINT_URL=https://YOUR-ENDPOINT.REGION.aws.endpoints.huggingface.cloud

# Only for the concurrency test (tests/concurrency/reserve-race.mjs)
# TEST_SELLER_EMAIL=seller_email
# TEST_SELLER_PASSWORD=seller_password
# TEST_LISTING_ID=listing_id
# TEST_BUYER_A_ID=buyer_a_user_id
# TEST_BUYER_B_ID=buyer_b_user_id
