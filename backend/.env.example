# Django Core Settings
SECRET_KEY=django-insecure-ecoloop-capstone-replace-in-production-!@#$1234
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (defaults to local SQLite if omitted)
# Option A - Single Connection URL:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/postgres
#
# Option B - Separate parameters:
# DB_ENGINE=postgresql
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# Hugging Face Inference API
HF_TOKEN=hf_your_access_token_here
HF_MODEL_ID=yangy50/garbage-classification
HF_VIT_MODEL=google/vit-base-patch16-224
# Optional Dedicated Endpoint:
# HF_ENDPOINT_URL=https://YOUR-ENDPOINT.REGION.aws.endpoints.huggingface.cloud

